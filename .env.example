TEXOS_DB_URL=
TEXOS_DB_USERNAME=
TEXOS_DB_PASSWORD=
TEXOS_FRONTEND_ORIGIN=
TEXOS_CUSTOMER_BASE_URL=
# Set it as true on Render.
TEXOS_COOKIE_SECURE=false
# Set it as None on Render
TEXOS_COOKIE_SAME_SITE=lax
MAIL_USERNAME=
# Use a Google App Password (16 characters, without spaces), not the account password.
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=
# Optional destination for the public contact form (defaults to the existing TexOS support inbox).
MAIL_CONTACT_TO=
# Required: use at least 32 random bytes. Generate locally with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TEXOS_JWT_SECRET=
GOOGLE_CLIENT_ID=
# Optional: enable web push notifications for restaurant order approval.
TEXOS_VAPID_PUBLIC_KEY=
TEXOS_VAPID_PRIVATE_KEY=
TEXOS_VAPID_SUBJECT=
# Generate a local 32-byte key for encrypting restaurant PhonePe credentials:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TEXOS_PHONEPE_CREDENTIAL_ENCRYPTION_KEY=
# Leave false until PhonePe approves TexOS's restaurant-wise merchant model.
TEXOS_PHONEPE_RESTAURANT_MERCHANTS_ENABLED=false
# Enable only if PhonePe provisions TexOS as a Partner and supplies the required merchant IDs.
TEXOS_PHONEPE_PARTNER_INTEGRATION=false
# Separate TexOS merchant credentials for SaaS subscription payments.
TEXOS_PHONEPE_SUBSCRIPTIONS_CLIENT_ID=
TEXOS_PHONEPE_SUBSCRIPTIONS_CLIENT_SECRET=
TEXOS_PHONEPE_SUBSCRIPTIONS_CLIENT_VERSION=1
TEXOS_PHONEPE_SUBSCRIPTIONS_MERCHANT_ID=
TEXOS_PHONEPE_SUBSCRIPTIONS_ENVIRONMENT=SANDBOX
TEXOS_PHONEPE_SUBSCRIPTIONS_WEBHOOK_KEY_ID=
TEXOS_PHONEPE_SUBSCRIPTIONS_WEBHOOK_SECRET=
TEXOS_ADMIN_USERNAME=
TEXOS_ADMIN_PASSWORD=
